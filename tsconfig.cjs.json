{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "node10",
    "rootDir": "./src",
    "outDir": "./dist/cjs",
    "declaration": true,
    "removeComments": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": "./src",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/**/*"
  ]
}
